<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ข้อมูลการสมัคร English for One Health</title>
    <!-- นำเข้า Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600&display=swap" rel="stylesheet">
    <!-- นำเข้า PapaParse สำหรับอ่านข้อมูลจาก Google Sheets CSV -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.3.2/papaparse.min.js"></script>
    
    <style>
        :root {
            --emerald-green: #50C878;
            --emerald-dark: #3da862;
            --emerald-light: #e8f7ed;
            --white: #ffffff;
            --text-dark: #333333;
            --border-color: #dddddd;
        }

        body {
            font-family: 'Prompt', sans-serif;
            background-color: #f4f9f5;
            color: var(--text-dark);
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background-color: var(--white);
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        h1 {
            text-align: center;
            color: var(--emerald-dark);
            margin-bottom: 30px;
            border-bottom: 3px solid var(--emerald-green);
            padding-bottom: 10px;
            display: inline-block;
        }

        .header-section {
            text-align: center;
        }

        /* ส่วนของ Filter */
        .filter-section {
            background-color: var(--emerald-light);
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .filter-title {
            font-weight: 600;
            color: var(--emerald-dark);
        }

        .checkbox-group {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .checkbox-label {
            display: flex;
            align-items: center;
            cursor: pointer;
            background: var(--white);
            padding: 8px 15px;
            border-radius: 20px;
            border: 1px solid var(--emerald-green);
            transition: all 0.2s;
        }

        .checkbox-label:hover {
            background: var(--emerald-green);
            color: var(--white);
        }

        input[type="checkbox"] {
            margin-right: 8px;
            accent-color: var(--emerald-dark);
            transform: scale(1.2);
        }

        .status-text {
            margin-left: auto;
            font-size: 0.9em;
            color: #666;
        }

        /* ส่วนของตาราง */
        .table-responsive {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid var(--border-color);
        }

        th {
            background-color: var(--emerald-green);
            color: var(--white);
            font-weight: 500;
            white-space: nowrap;
            position: sticky;
            top: 0;
        }

        tr:nth-child(even) {
            background-color: #fafafa;
        }

        tr:hover {
            background-color: var(--emerald-light);
        }

        .loading {
            text-align: center;
            padding: 50px;
            font-size: 1.2em;
            color: var(--emerald-dark);
        }

        #empty-message {
            text-align: center;
            padding: 30px;
            color: #888;
            display: none;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header-section">
        <h1>ผลการสมัคร English for One Health</h1>
        <p>นิสิตชั้นปีที่ 1 คณะพยาบาลศาสตร์</p>
    </div>

    <!-- แผงกรองข้อมูล -->
    <div class="filter-section">
        <span class="filter-title">กรองรูปแบบการเรียน: </span>
        <div class="checkbox-group">
            <label class="checkbox-label">
                <input type="checkbox" class="filter-cb" value="online"> Online
            </label>
            <label class="checkbox-label">
                <input type="checkbox" class="filter-cb" value="onsite"> Onsite
            </label>
            <label class="checkbox-label">
                <input type="checkbox" class="filter-cb" value="ทั้ง 2"> ได้ทั้ง 2 รูปแบบ
            </label>
        </div>
        <div class="status-text">
            จำนวนข้อมูลที่แสดง: <span id="count-display">0</span> รายการ
        </div>
    </div>

    <!-- ตารางแสดงผล -->
    <div class="table-responsive">
        <div id="loading" class="loading">กำลังโหลดข้อมูล...</div>
        <table id="data-table" style="display: none;">
            <thead id="table-head">
                <!-- Header จะถูกสร้างด้วย JavaScript -->
            </thead>
            <tbody id="table-body">
                <!-- ข้อมูลจะถูกใส่ที่นี่ -->
            </tbody>
        </table>
        <div id="empty-message">ไม่พบข้อมูลที่ตรงกับเงื่อนไข</div>
    </div>
</div>

<script>
    // ไอดีของ Google Sheet ของคุณ
    const sheetId = '1Q8rGn3Zjgy2WfL6_bap62sTH4gIspZlRq7CGSiOZo9w';
    // URL สำหรับดึงข้อมูลเป็น CSV
    const csvUrl = `https://docs.google.com/spreadsheets/d/${sheetId}/export?format=csv`;

    let allData = [];
    let headers = [];

    // ดึงข้อมูลเมื่อโหลดหน้าเว็บ
    window.onload = () => {
        Papa.parse(csvUrl, {
            download: true,
            header: false, // เราจะจัดการ header เองเพราะต้องการใช้ Column B-E
            complete: function(results) {
                const data = results.data;
                
                if(data.length > 0) {
                    // แถวแรกคือ Header (ดึงเฉพาะ Column B, C, D, E คือ index 1, 2, 3, 4)
                    headers = [data[0][1], data[0][2], data[0][3], data[0][4]];
                    
                    // แถวที่เหลือคือข้อมูล
                    for(let i = 1; i < data.length; i++) {
                        // เช็คว่ามีข้อมูลรหัสนิสิตหรือชื่อ (ป้องกันแถวว่าง)
                        if(data[i][1] || data[i][2]) {
                            allData.push([
                                data[i][1] || '-', // Column B
                                data[i][2] || '-', // Column C
                                data[i][3] || '-', // Column D
                                data[i][4] || '-'  // Column E (รูปแบบการเรียน)
                            ]);
                        }
                    }

                    renderHeader();
                    renderTable(allData);
                    
                    document.getElementById('loading').style.display = 'none';
                    document.getElementById('data-table').style.display = 'table';
                }
            },
            error: function(err) {
                document.getElementById('loading').innerHTML = "เกิดข้อผิดพลาดในการโหลดข้อมูล โปรดตรวจสอบว่าไฟล์ Google Sheet เปิดสาธารณะ (Anyone with the link) แล้ว";
                console.error(err);
            }
        });
    };

    // ฟังก์ชันสร้างหัวตาราง
    function renderHeader() {
        const thead = document.getElementById('table-head');
        let tr = document.createElement('tr');
        
        // เพิ่มคอลัมน์ลำดับ
        let thIndex = document.createElement('th');
        thIndex.innerText = "ลำดับ";
        tr.appendChild(thIndex);

        headers.forEach(headerText => {
            let th = document.createElement('th');
            th.innerText = headerText || "ไม่ระบุ";
            tr.appendChild(th);
        });
        thead.appendChild(tr);
    }

    // ฟังก์ชันแสดงผลตาราง
    function renderTable(dataToRender) {
        const tbody = document.getElementById('table-body');
        tbody.innerHTML = ''; // เคลียร์ของเก่า

        if(dataToRender.length === 0) {
            document.getElementById('empty-message').style.display = 'block';
            document.getElementById('data-table').style.display = 'none';
        } else {
            document.getElementById('empty-message').style.display = 'none';
            document.getElementById('data-table').style.display = 'table';

            dataToRender.forEach((row, index) => {
                let tr = document.createElement('tr');
                
                // คอลัมน์ลำดับ
                let tdIndex = document.createElement('td');
                tdIndex.innerText = index + 1;
                tr.appendChild(tdIndex);

                // คอลัมน์ข้อมูล
                row.forEach(cellData => {
                    let td = document.createElement('td');
                    td.innerText = cellData;
                    tr.appendChild(td);
                });
                
                tbody.appendChild(tr);
            });
        }

        // อัปเดตตัวเลขจำนวน
        document.getElementById('count-display').innerText = dataToRender.length;
    }

    // ระบบฟิลเตอร์
    const checkboxes = document.querySelectorAll('.filter-cb');
    checkboxes.forEach(cb => {
        cb.addEventListener('change', applyFilters);
    });

    function applyFilters() {
        // หาว่า checkbox อันไหนถูกติ๊กบ้าง
        const checkedValues = Array.from(checkboxes)
                                .filter(cb => cb.checked)
                                .map(cb => cb.value.toLowerCase());

        // ถ้าไม่มีการติ๊กเลย ให้แสดงข้อมูลทั้งหมด
        if(checkedValues.length === 0) {
            renderTable(allData);
            return;
        }

        // กรองข้อมูล: ถ้าข้อมูลในคอลัมน์ E (index 3 ใน array ของเรา) มีคำที่ตรงกับที่เลือกไว้
        const filteredData = allData.filter(row => {
            const learningType = row[3] ? row[3].toLowerCase() : "";
            
            // เช็คว่า learningType ตรงกับ checkbox ไหนที่เลือกไว้หรือไม่
            return checkedValues.some(val => learningType.includes(val));
        });

        renderTable(filteredData);
    }
</script>

</body>
</html>
